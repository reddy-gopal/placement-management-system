MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/nexstep
PORT=4000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES=7d

# Resend API Configuration
# Replace re_xxxxxxxxx with your real Resend API key (from https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxx
# Resend default testing from address: onboarding@resend.dev (or your verified domain like info@yourdomain.com)
RESEND_FROM_EMAIL=onboarding@resend.dev
