PORT=4000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/nexstep?retryWrites=true&w=majority
# Optional: set if Atlas fails with "querySrv ECONNREFUSED" (local DNS refuses Node's lookups)
# DNS_SERVERS=8.8.8.8,1.1.1.1
# Development only: skip login and act as one fixed dev student (refused when NODE_ENV=production)
# AUTH_DISABLED=true
# DEV_USER_ID=000000000000000000000001
JWT_SECRET=replace_with_a_long_random_secret
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
RESEND_API_KEY=re_your_resend_api_key
